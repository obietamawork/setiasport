APP_NAME="Setia Sport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=setiasport
DB_USERNAME=setiasport
DB_PASSWORD=secret   # ganti di produksi

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Notifikasi pelanggan lewat Resend HTTP API (KEP-004), bukan SMTP.
# Di lokal biarkan "log": email tertulis ke storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@setiasport.test"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Payment gateway. Biarkan kosong sampai merchant disetujui — sistem tetap
# berjalan penuh dengan transfer manual, tombol bayar online sekadar tidak muncul.
PEMBAYARAN_GERBANG=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUKSI=false

VITE_APP_NAME="${APP_NAME}"
