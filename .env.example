APP_NAME="Setia Sport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=setiasport
DB_USERNAME=setiasport
DB_PASSWORD=secret   # ganti di produksi

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Notifikasi pelanggan lewat Resend HTTP API (KEP-004), bukan SMTP.
# Di lokal biarkan "log": email tertulis ke storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@setiasport.test"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Ongkos kirim dan pelacakan paket lewat Biteship (KEP-057). Selama
# ONGKIR_PENYEDIA=mati, ongkir dihitung admin seperti sebelumnya dan tidak ada
# panggilan keluar sama sekali. Area asal toko BUKAN di sini (KEP-067): diisi
# staf lewat Pengaturan > Pengiriman di panel, dicari lewat kotak pencarian.
ONGKIR_PENYEDIA=mati
BITESHIP_KUNCI=
ONGKIR_KURIR=jne,jnt

# Chat CS di website (KEP-030). Dibatalkan klien untuk sementara (KEP-034):
# false menyembunyikan fitur dan tab Pengaturan-nya sepenuhnya.
FITUR_CS=false

# Chat CS realtime (KEP-030). Produksi: isi dari dasbor Pusher Channels
# (paket Sandbox gratis), klaster ap1. Biarkan PUSHER_HOST dan PUSHER_CLIENT_*
# kosong; itu hanya dipakai untuk Reverb di lokal. Kalau kunci kosong, chat
# tetap berjalan lewat polling lambat, tanpa realtime.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_CLIENT_HOST=
PUSHER_CLIENT_PORT=
PUSHER_CLIENT_TLS=true

VITE_APP_NAME="${APP_NAME}"
